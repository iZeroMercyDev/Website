# ───────────── Required ─────────────
# Postgres connection string (Neon / Supabase / local docker-compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bankai?schema=public"

# ───────────── Optional (feature switches) ─────────────
# Playback API base URL — must include https://  (falls back to a built-in default if empty)
STREAMING_API_URL=

# Needed once Auth.js sessions are enabled. Generate: openssl rand -base64 32
AUTH_SECRET=

# AniList account linking (https://anilist.co/settings/developer)
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=

# Profile picture / banner uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Captions / AI
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Anime logos
FANART_TV_API_KEY=

# ───────────── Seeding only (npm run db:seed) ─────────────
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
